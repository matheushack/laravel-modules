{
    "name": "matheushack/laravel-modules",
    "description": "Gerador e carregador de módulos para Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laravel-modules",
        "modules",
        "modular",
        "artisan",
        "generator"
    ],
    "authors": [{
        "name": "Matheus Hack",
        "email": "matheushack90@gmail.com"
    }],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Matheushack\\LaravelModules\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Matheushack\\LaravelModules\\LaravelModulesServiceProvider"
            ],
            "aliases": {
                "LaravelModules": "Matheushack\\LaravelModules\\Facades\\LaravelModules"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
